{
  "name": "xivig-text-editor",
  "version": "1.2.0",
  "productName": "Xivig Text Editor",
  "private": true,
  "description": "⚡ Ultra-fast, keyboard-first desktop code editor built for pure velocity — Sublime-grade multi-cursor editing, live web feedback, and pixel-perfect design tooling.",
  "author": {
    "name": "Bandhu",
    "email": "dev@xivig.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/xivig/xivig-text-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/xivig/xivig-text-editor.git"
  },
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc --project tsconfig.node.json --noEmit",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.xivig.texteditor",
    "productName": "Xivig Text Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xivig Text Editor"
    },
    "linux": {
      "maintainer": "Bandhu <dev@xivig.com>",
      "executableName": "xivig-text-editor",
      "category": "Development",
      "icon": "public/logo.png",
      "artifactName": "Xivig-Text-Editor-${version}-linux-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "Xivig-Text-Editor-${version}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Xivig-Text-Editor-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "public/logo.png",
      "artifactName": "Xivig-Text-Editor-${version}-mac.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal",
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal",
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.4",
    "@types/dompurify": "^3.0.5",
    "@types/js-beautify": "^1.14.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.1",
    "dompurify": "^3.5.0",
    "js-beautify": "^2.0.3",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "minimatch": "^11.0.9",
    "glob": "^14.0.6"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
